{
  "name": "icon-forge",
  "productName": "Icon Forge",
  "version": "1.1.10",
  "description": "Make icon sets and icon fonts from a keyword. Flux Schnell runs on your own PC.",
  "author": "Johan Peens",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node make-icon.js",
    "dist": "electron-builder --win nsis",
    "engine": "node scripts/fetch-engine.js",
    "prestart": "node scripts/fetch-engine.js",
    "prereq": "node scripts/fetch-prereq.js",
    "predist": "node scripts/fetch-engine.js && node scripts/fetch-prereq.js"
  },
  "build": {
    "appId": "com.johanpeens.iconforge",
    "productName": "Icon Forge",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server.js",
      "generate.js",
      "svgedit.js",
      "fontmaker.js",
      "modelstore.js",
      "public/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!start-server.*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "shortcutName": "Icon Forge"
    }
  },
  "dependencies": {
    "@neplex/vectorizer": "^0.1.0",
    "svg2ttf": "^6.1.0",
    "ttf2woff": "^3.0.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5"
  }
}
